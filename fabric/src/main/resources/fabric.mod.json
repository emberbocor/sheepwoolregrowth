{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Feed wheat to a sheared adult sheep and its wool grows back right away, just like after eating grass. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/sheepwoolregrowth",
    "sources": "https://github.com/emberbocor/sheepwoolregrowth",
    "issues": "https://github.com/emberbocor/sheepwoolregrowth/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  }
}
